<mxfile host="build_diagrams.py"><diagram name="w7_realnet_design"><mxGraphModel grid="0" page="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Data (each used for one purpose only)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#0072B2;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#0B4F7C;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1040" height="150" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Previous day&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D5B69&quot;&gt;2 sessions · 222 flows · local repair flows and site envelope only&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=1.5;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="320" height="86" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Evaluation evening&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D5B69&quot;&gt;12 blocks · 5 min or 90 MB each · 10 min apart · scored only&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=1.5;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="380" y="60" width="320" height="86" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Benchmark test split&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D5B69&quot;&gt;later period, never trained on · attack detection&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0072B2;strokeWidth=1.5;fontSize=12;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="720" y="60" width="320" height="86" as="geometry"/></mxCell><mxCell id="c5" value="Conditions (5 label seeds each) · local flows come from the previous day" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF6F1;strokeColor=#007F68;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#00594A;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="195" width="640" height="300" as="geometry"/></mxCell><mxCell id="c6" value="Source only (deployed model)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#007F68;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="600" height="28" as="geometry"/></mxCell><mxCell id="c7" value="Few-shot: + k = 50 labelled target attacks per class" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#007F68;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="40" y="275" width="600" height="28" as="geometry"/></mxCell><mxCell id="c8" value="+ 30 lab service flows (does a lab repair transfer?)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#007F68;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="600" height="28" as="geometry"/></mxCell><mxCell id="c9" value="+ 30 local flows: port-spread · triaged · least confident" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#007F68;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="40" y="361" width="600" height="28" as="geometry"/></mxCell><mxCell id="c10" value="+ local anomaly rule: threshold · isolation forest · refit · exemplar envelope" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#007F68;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="40" y="404" width="600" height="28" as="geometry"/></mxCell><mxCell id="c11" value="All of the above again without port and TCP-window features" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#007F68;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeom