as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Measures (evening blocks · benchmark test)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F6ECF3;strokeColor=#A8558E;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#6E2F5C;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="680" y="195" width="380" height="300" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Alert rate per block&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D5B69&quot;&gt;no attacks generated: alerts are upper bounds on false alerts&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A8558E;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="700" y="240" width="340" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Per-block sign test&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D5B69&quot;&gt;blocks are the unit; seeds share blocks&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A8558E;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="700" y="302" width="340" height="50" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Benchmark detection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D5B69&quot;&gt;class-balanced, same conditions&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A8558E;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="700" y="364" width="340" height="50" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Mechanism audits&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#4D5B69&quot;&gt;alerts by service · benign-envelope features · offload counterfactual&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A8558E;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="700" y="426" width="340" height="50" as="geometry"/></mxCell><mxCell id="c22" value="Privacy: household consent · passive capture only · keyed pseudonyms · aggregates in shared outputs · pcaps stay local. Repeated on a second evening for independence." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#6B7785;strokeWidth=1.5;fontSize=11;fontColor=#1F2D3D;" vertex="1" parent="1"><mxGeometry x="20" y="515" width="1040" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>