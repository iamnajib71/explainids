{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "explainids",
      "runtimeExecutable": ".venv-ml/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "api.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "explainids-static",
      "runtimeExecutable": ".venv-ml/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--directory",
        "data/static_site"
      ],
      "port": 8090
    }
  ]
}